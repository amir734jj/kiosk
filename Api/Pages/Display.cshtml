@page "/display"
@model Api.Pages.DisplayModel

@{
    Layout = null;
    var data = Model.Data;
    var cst = TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");
    var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, cst);
    var bgStyle = data?.HasBackgroundImage == true
        ? "background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%) center/cover fixed; background: url('/api/public/background') center/cover fixed, linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);"
        : "background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="@(data?.RefreshIntervalSeconds ?? 60)" />
    <title>Office Directory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Roboto', sans-serif; min-height: 100vh; display: flex; flex-direction: column; @Html.Raw(bgStyle) }
        .kiosk-header, .kiosk-announce, .kiosk-card { background: var(--bs-dark) !important; }
        .office-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; align-content: start; }
        .unit-badge { background: #e94560; font-size: 1.5rem; font-weight: bold; padding: 0.2rem 0.8rem; border-radius: 8px; }

        /* Announcement ticker */
        .ticker {
            background: var(--bs-dark);
            border-top: 2px solid rgba(255, 193, 7, 0.4);
            padding: 0.5rem 0;
            overflow: hidden;
            white-space: nowrap;
            display: flex;
            align-items: center;
        }
        .ticker-label {
            background: #ffc107;
            color: #1a1a1a;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 0.25rem 0.75rem;
            margin: 0 1rem 0 0.75rem;
            flex-shrink: 0;
            border-radius: 4px;
            letter-spacing: 0.04em;
        }
        .ticker-track {
            display: inline-block;
            white-space: nowrap;
            animation: ticker-scroll var(--ticker-duration, 30s) linear infinite;
        }
        .ticker-item {
            color: #ffc107;
            font-size: 1.1rem;
            margin-right: 4rem;
        }
        .ticker-item strong { color: #fff; }
        @@keyframes ticker-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* Advertisement overlay */
        .ad-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 3rem;
            opacity: 0;
            transition: opacity 0.5s ease;
        }
        .ad-overlay.active { display: flex; }
        .ad-overlay.visible { opacity: 1; }
        .ad-overlay .ad-title { font-size: 3.5rem; font-weight: 700; margin-bottom: 1rem; color: #fff; }
        .ad-overlay .ad-description { font-size: 1.5rem; color: rgba(255,255,255,0.85); max-width: 900px; margin-bottom: 2rem; }
        .ad-overlay .ad-photos { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; max-width: 100%; }
        .ad-overlay .ad-photos img { max-height: 50vh; max-width: 80vw; object-fit: contain; border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
        .ad-overlay .ad-badge { position: absolute; top: 1.5rem; right: 1.5rem; background: rgba(255,193,7,0.9); color: #1a1a1a; padding: 0.3rem 1rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem; }
        .ad-progress { position: absolute; bottom: 0; left: 0; height: 4px; background: #ffc107; transition: width linear; }

        /* Scale UI based on viewport — baseline 1920px (1080p) = zoom 1 */
        @@media (min-width: 2200px) { body { zoom: 1.15; } }
        @@media (min-width: 2560px) { body { zoom: 1.33; } }
        @@media (min-width: 3000px) { body { zoom: 1.56; } }
        @@media (min-width: 3840px) { body { zoom: 2; } }
    </style>
</head>
<body>

    @* ── Header ── *@
    <nav class="navbar kiosk-header border-bottom border-secondary px-4 py-2">
        <span class="navbar-brand text-white fs-3 fw-bold mb-0">
            <i class="bi bi-building me-2"></i>Office Directory
        </span>
        <div class="d-flex align-items-center gap-4">
            @if (data?.Weather is not null)
            {
                <div class="d-flex align-items-center gap-2 fs-4">
                    <i class="bi @data.Weather.Icon"></i>
                    <span>@($"{data.Weather.TemperatureF:F0}")&deg;F</span>
                    <span class="text-white-50">@data.Weather.Description</span>
                </div>
            }
            <div class="text-end">
                <div class="fs-4"><i class="bi bi-clock me-1"></i>@now.ToString("h:mm tt")</div>
                <div class="text-white-50 fs-6">@now.ToString("dddd, MMMM d, yyyy")</div>
                @if (data?.TodayHoliday is not null)
                {
                    <div><span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@data.TodayHoliday</span></div>
                }
            </div>
        </div>
    </nav>

    @* ── Office Cards ── *@
    @if (data?.Offices.Count > 0)
    {
        <div class="office-grid p-4">
            @foreach (var o in data.Offices)
            {
                <div class="card kiosk-card border-secondary text-center">
                    <div class="card-body py-2 px-3">
                        <span class="badge unit-badge mb-2">@o.UnitNumber</span>
                        @if (o.Floor.HasValue)
                        {
                            <p class="card-text text-white-50 mb-1"><i class="bi bi-layers-fill me-1"></i>Floor @o.Floor</p>
                        }
                        <h5 class="card-title mb-1">@o.Name</h5>
                        @foreach (var name in o.Names)
                        {
                            <p class="card-text text-white-50 mb-0"><i class="bi bi-person-fill me-1"></i>@name</p>
                        }
                        @if (!string.IsNullOrEmpty(o.PhoneNumber))
                        {
                            <p class="card-text text-white-50 mb-0"><i class="bi bi-telephone-fill me-1"></i>@o.PhoneNumber</p>
                        }
                        @if (!string.IsNullOrEmpty(o.Note))
                        {
                            <p class="card-text text-white-50 mb-0"><i class="bi bi-sticky-fill me-1"></i>@o.Note</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-white-50 mt-5 fs-5">
            <i class="bi bi-inbox fs-1"></i><br />No offices configured yet
        </div>
    }

    @* ── Announcement Ticker ── *@
    @if (data?.Announcements.Count > 0)
    {
        <div class="ticker mt-auto">
            <span class="ticker-label"><i class="bi bi-megaphone-fill me-1"></i>ANNOUNCEMENTS</span>
            <div style="overflow:hidden;flex:1;">
                <div class="ticker-track" id="tickerTrack">
                    @* Items are duplicated so the scroll loops seamlessly *@
                    @for (var i = 0; i < 2; i++)
                    {
                        @foreach (var a in data.Announcements)
                        {
                            <span class="ticker-item"><strong>@a.Title</strong> &mdash; @a.Content</span>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @* ── Advertisement Overlay ── *@
    <div class="ad-overlay" id="adOverlay">
        <span class="ad-badge"><i class="bi bi-megaphone-fill me-1"></i>ADVERTISEMENT</span>
        <div class="ad-title" id="adTitle"></div>
        <div class="ad-description" id="adDescription"></div>
        <div class="ad-photos" id="adPhotos"></div>
        <div class="ad-progress" id="adProgress"></div>
    </div>

    @* ── Footer ── *@
    <footer class="text-center text-white-50 small py-2">
        @{
            var parts = new List<string>();
            if (!string.IsNullOrEmpty(data?.KioskName))
            {
                parts.Add(data.KioskName);
            }
            var interval = data?.RefreshIntervalSeconds ?? 60;
            var refreshText = interval switch
            {
                >= 60 when interval % 60 == 0 => $"Auto-refreshes every {interval / 60} min",
                >= 60 => $"Auto-refreshes every {interval / 60}m {interval % 60}s",
                _ => $"Auto-refreshes every {interval}s"
            };
            parts.Add(refreshText);
        }
        <span>@string.Join(" • ", parts)</span>
        <span> • Last updated: @now.ToString("h:mm:ss tt")</span>
    </footer>

<script>
    // Adjust ticker speed based on content width (~80px/s)
    (function () {
        var track = document.getElementById('tickerTrack');
        if (track) {
            var width = track.scrollWidth / 2;
            var duration = Math.max(15, width / 80);
            track.style.setProperty('--ticker-duration', duration + 's');
            track.style.animationDuration = duration + 's';
        }
    })();

    // Advertisement rotation — show an ad every 5 minutes for 10 seconds
    (function () {
        var AD_INTERVAL = 5 * 60 * 1000; // 5 minutes
        var AD_DURATION = 10 * 1000;      // 10 seconds
        var adIndex = 0;
        var ads = null;

        function fetchAds() {
            fetch('/api/public/ads/active')
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (data) { ads = data; })
                .catch(function () { ads = []; });
        }

        function showAd() {
            if (!ads || ads.length === 0) return;

            var ad = ads[adIndex % ads.length];
            adIndex++;

            var overlay = document.getElementById('adOverlay');
            var title = document.getElementById('adTitle');
            var desc = document.getElementById('adDescription');
            var photos = document.getElementById('adPhotos');
            var progress = document.getElementById('adProgress');

            title.textContent = ad.title;
            desc.textContent = ad.description;
            photos.innerHTML = '';

            if (ad.photos && ad.photos.length > 0) {
                ad.photos.forEach(function (p) {
                    var img = document.createElement('img');
                    img.src = '/api/public/ads/' + ad.id + '/photos/' + p.id;
                    img.alt = p.originalFileName;
                    photos.appendChild(img);
                });
            }

            // Animate in
            overlay.classList.add('active');
            progress.style.transition = 'none';
            progress.style.width = '0%';
            requestAnimationFrame(function () {
                overlay.classList.add('visible');
                requestAnimationFrame(function () {
                    progress.style.transition = 'width ' + (AD_DURATION / 1000) + 's linear';
                    progress.style.width = '100%';
                });
            });

            // Hide after duration
            setTimeout(function () {
                overlay.classList.remove('visible');
                setTimeout(function () {
                    overlay.classList.remove('active');
                }, 500); // match CSS transition
            }, AD_DURATION);
        }

        fetchAds();
        // Refresh ad list every 5 minutes (just before showing)
        setInterval(function () {
            fetchAds();
            setTimeout(showAd, 500); // small delay for fetch to complete
        }, AD_INTERVAL);
    })();
</script>
</body>
</html>
