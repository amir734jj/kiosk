@page "/admin/global-config"
@inject ApiService Api
@inject AuthService Auth
@using Refit

<PageTitle>Global Config</PageTitle>

<h2 class="mb-3"><i class="bi bi-gear me-2"></i>Global Config</h2>

@if (!string.IsNullOrEmpty(_error))
{
    <HxAlert Color="ThemeColor.Danger">@_error</HxAlert>
}
@if (!string.IsNullOrEmpty(_success))
{
    <HxAlert Color="ThemeColor.Success" CssClass="alert-dismissible">
        @_success
        <button type="button" class="btn-close" @onclick="() => _success = null"></button>
    </HxAlert>
}

@if (_loading)
{
    <div class="text-center py-5"><HxSpinner /></div>
}
else if (_config is not null)
{
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <HxInputText Label="Kiosk Name" @bind-Value="_config.KioskName" Placeholder="e.g. Amir Building" Hint="Shown at the bottom of the public display" />
                </div>
                <div class="col-md-4">
                    <HxInputText Label="City" @bind-Value="_config.City" Placeholder="e.g. Milwaukee" Hint="Used for weather and background image" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Background Style</label>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var style in Enum.GetValues<BackgroundStyle>())
                        {
                            var (displayName, tooltip) = style switch
                            {
                                BackgroundStyle.Color => ("Solid Color", "Dark gradient background with no image"),
                                BackgroundStyle.CityPhoto => ("City Photo", "Fetches a photo of the configured city from Wikimedia Commons"),
                                BackgroundStyle.StaticPhoto => ("Static Photo", "Uses a random image from the server's built-in photo collection (add image to the repository to have it included)"),
                                BackgroundStyle.UploadedImage => ("Uploaded Image", "Uses a custom image you upload (stored in cloud storage)"),
                                _ => (style.ToString(), "")
                            };
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="bg-@style" name="backgroundStyle"
                                       checked="@(_config.BackgroundStyle == style)"
                                       @onchange="() => _config.BackgroundStyle = style" />
                                <label class="form-check-label" for="bg-@style" title="@tooltip">
                                    @displayName
                                    <i class="bi bi-info-circle text-muted ms-1" title="@tooltip"></i>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <HxInputNumber Label="Refresh Interval (seconds)" @bind-Value="_config.RefreshIntervalSeconds" Min="10" Placeholder="e.g. 60" Hint="How often the display page auto-refreshes" />
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">Upload Background Image</label>
                    <InputFile OnChange="OnFileSelected" accept="@ImageUpload.AcceptAttribute" class="form-control" />
                    <div class="form-text">JPEG, PNG, or WebP — max 10 MB.</div>
                    @if (_uploading)
                    {
                        <div class="mt-2"><HxSpinner Size="SpinnerSize.Small" CssClass="me-1" /> Uploading…</div>
                    }
                    @if (!string.IsNullOrEmpty(_uploadMessage))
                    {
                        <div class="mt-2 text-success"><i class="bi bi-check-circle me-1"></i>@_uploadMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_uploadError))
                    {
                        <div class="mt-2 text-danger"><i class="bi bi-exclamation-circle me-1"></i>@_uploadError</div>
                    }
                </div>
            </div>
            @if (_images.Count > 0)
            {
                    <div class="row g-3 mt-1">
                        <div class="col-md-8">
                            <label class="form-label">Uploaded Images</label>
                            <ul class="list-group">
                                @foreach (var img in _images)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <a href="api/global-config/background-image/@img.Id" target="_blank" class="fw-bold text-decoration-none">
                                                <i class="bi bi-download me-1"></i>@img.OriginalFileName
                                            </a>
                                            <small class="text-muted ms-2">@img.ContentType</small>
                                            <small class="text-muted ms-2">by @img.UploadedBy</small>
                                            <small class="text-muted ms-2">@img.UploadedAt.ToString("g")</small>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteImage(img.Id)" disabled="@_deleting">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            <div class="mt-3">
                <HxButton Text="Save" Color="ThemeColor.Primary" Icon="BootstrapIcon.CheckLg" OnClick="Save" Enabled="!_saving">
                    @if (_saving) { <HxSpinner Size="SpinnerSize.Small" CssClass="me-1" /> }
                </HxButton>
            </div>
        </div>
    </div>
}

@code {
    private GlobalConfigModel? _config;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _success;
    private string? _uploadMessage;
    private string? _uploadError;
    private bool _uploading;
    private List<BackgroundImageDto> _images = [];
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _config = await Api.GetGlobalConfigAsync();
            _images = await Api.ListBackgroundImagesAsync();
        }
        catch { _error = "Failed to load config."; }
        finally { _loading = false; }
    }

    private async Task Save()
    {
        _error = null;
        _success = null;
        _saving = true;
        try
        {
            await Api.SaveGlobalConfigAsync(_config!);
            _success = "Config saved successfully.";
        }
        catch { _error = "Failed to save config."; }
        finally { _saving = false; }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        _uploadMessage = null;
        _uploadError = null;
        _uploading = true;
        StateHasChanged();

        try
        {
            var file = args.File;
            if (file.Size > ImageUpload.MaxFileSize)
            {
                _uploadError = "File must be under 10 MB.";
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: ImageUpload.MaxFileSize);
            var part = new StreamPart(stream, file.Name, file.ContentType);
            await Api.UploadBackgroundImageAsync(part);

            _uploadMessage = $"'{file.Name}' uploaded successfully.";
            _images = await Api.ListBackgroundImagesAsync();
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteImage(string id)
    {
        _deleting = true;
        try
        {
            await Api.DeleteBackgroundImageAsync(id);
            _images = await Api.ListBackgroundImagesAsync();
            _success = "Image deleted.";
        }
        catch { _error = "Failed to delete image."; }
        finally { _deleting = false; }
    }
}
