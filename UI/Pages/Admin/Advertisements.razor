@page "/admin/advertisements"
@using Refit
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Manage Advertisements</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-card-image me-2"></i>Advertisements</h2>
    <HxButton Text="Add Advertisement" Color="ThemeColor.Primary" Icon="BootstrapIcon.PlusLg" OnClick="() => _showForm = !_showForm" />
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <HxAlert Color="ThemeColor.Danger" CssClass="alert-dismissible">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null"></button>
    </HxAlert>
}

@if (_showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5>@(_editId.HasValue ? "Edit" : "New") Advertisement</h5>
            <div class="row g-3">
                <div class="col-md-8">
                    <HxInputText Label="Title" @bind-Value="_formTitle" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Active</label>
                    <select @bind="_formIsActive" class="form-select">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
                <div class="col-12">
                    <HxInputTextArea Label="Description" @bind-Value="_formDescription" Rows="3" />
                </div>
            </div>
            <div class="mt-3">
                <HxButton Text="Save" Color="ThemeColor.Success" Icon="BootstrapIcon.CheckLg" OnClick="Save" CssClass="me-2" />
                <HxButton Text="Cancel" Color="ThemeColor.Secondary" OnClick="CancelForm" />
            </div>
        </div>
    </div>
}

@if (_items is null)
{
    <div class="text-center py-5"><HxSpinner /></div>
}
else if (_items.Count == 0)
{
    <HxAlert Color="ThemeColor.Info">No advertisements yet.</HxAlert>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Photos</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th style="width:200px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ad in _items)
                {
                    <tr class="@(!ad.IsActive ? "table-secondary" : "")">
                        <td><strong>@ad.Title</strong></td>
                        <td class="text-truncate" style="max-width:250px">@ad.Description</td>
                        <td>
                            <HxBadge Color="ThemeColor.Info">@ad.Photos.Count photo(s)</HxBadge>
                        </td>
                        <td>
                            <HxBadge Color="@(ad.IsActive ? ThemeColor.Success : ThemeColor.Secondary)">
                                @(ad.IsActive ? "Active" : "Inactive")
                            </HxBadge>
                        </td>
                        <td>@ad.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")</td>
                        <td>
                            <HxButton Icon="BootstrapIcon.Pencil" Color="ThemeColor.Primary" Size="ButtonSize.Small" Outline="true" OnClick="() => Edit(ad)" CssClass="me-1" />
                            <HxButton Icon="BootstrapIcon.Image" Color="ThemeColor.Info" Size="ButtonSize.Small" Outline="true" OnClick="() => ManagePhotos(ad)" CssClass="me-1" />
                            <HxButton Icon="BootstrapIcon.Eye" Color="ThemeColor.Warning" Size="ButtonSize.Small" Outline="true" OnClick="() => Preview(ad.Id)" CssClass="me-1" />
                            <HxButton Icon="BootstrapIcon.Trash" Color="ThemeColor.Danger" Size="ButtonSize.Small" Outline="true" OnClick="() => Delete(ad.Id)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── Photo Management Panel ── *@
@if (_photoAdId.HasValue)
{
    var ad = _items?.FirstOrDefault(a => a.Id == _photoAdId.Value);
    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-images me-2"></i>Photos for "@(ad?.Title)"</h5>
            <HxButton Text="Close" Color="ThemeColor.Secondary" Size="ButtonSize.Small" OnClick="() => _photoAdId = null" />
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Upload Photo</label>
                <InputFile OnChange="OnPhotoSelected" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" />
            </div>
            @if (_uploading)
            {
                <div class="mb-3"><HxSpinner /> Uploading...</div>
            }
            @if (ad?.Photos.Count > 0)
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var photo in ad.Photos)
                    {
                        <div class="position-relative" style="width:200px;">
                            <img src="api/public/ads/@ad.Id/photos/@photo.Id" alt="@photo.OriginalFileName" class="img-fluid rounded shadow-sm" />
                            <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1" @onclick="() => DeletePhoto(ad.Id, photo.Id)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No photos uploaded yet.</p>
            }
        </div>
    </div>
}

@code {
    private List<AdvertisementDto>? _items;
    private bool _showForm;
    private int? _editId;
    private string _formTitle = "";
    private string _formDescription = "";
    private string _formIsActive = "true";
    private string? _error;
    private int? _photoAdId;
    private bool _uploading;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => _items = await Api.GetAdvertisementsAsync();

    private void Edit(AdvertisementDto ad)
    {
        _editId = ad.Id;
        _formTitle = ad.Title;
        _formDescription = ad.Description;
        _formIsActive = ad.IsActive.ToString().ToLower();
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _editId = null;
        _formTitle = "";
        _formDescription = "";
        _formIsActive = "true";
    }

    private async Task Save()
    {
        _error = null;
        var isActive = _formIsActive == "true";

        if (_editId.HasValue)
        {
            var ok = await Api.UpdateAdvertisementAsync(_editId.Value, new UpdateAdvertisementRequest(_formTitle, _formDescription, isActive));
            if (!ok) { _error = "Failed to update."; return; }
        }
        else
        {
            var (ok, error) = await Api.CreateAdvertisementAsync(new CreateAdvertisementRequest(_formTitle, _formDescription));
            if (!ok) { _error = error; return; }
        }
        CancelForm();
        await Load();
    }

    private async Task Delete(int id)
    {
        await Api.DeleteAdvertisementAsync(id);
        if (_photoAdId == id) _photoAdId = null;
        await Load();
    }

    private void ManagePhotos(AdvertisementDto ad)
    {
        _photoAdId = _photoAdId == ad.Id ? null : ad.Id;
    }

    private void Preview(int id)
    {
        Nav.NavigateTo($"/display/ad/{id}", forceLoad: true);
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (_photoAdId is null) return;
        _uploading = true;
        _error = null;

        try
        {
            var file = e.File;
            var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var streamPart = new StreamPart(stream, file.Name, file.ContentType);
            var (ok, error) = await Api.UploadAdPhotoAsync(_photoAdId.Value, streamPart);
            if (!ok) _error = error ?? "Upload failed.";
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeletePhoto(int adId, string photoId)
    {
        await Api.DeleteAdPhotoAsync(adId, photoId);
        await Load();
    }
}
